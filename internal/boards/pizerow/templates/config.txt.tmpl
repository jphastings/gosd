kernel=kernel.img
initramfs {{.InitramfsName}} followkernel
enable_uart=1
disable_splash=1
boot_delay=0
avoid_warnings=1
# GoSD (github.com/jphastings/gosd): dtparam=i2c_arm=on and dtparam=spi=on
# are both no-ops on THIS board - dtparam works by the Pi firmware patching
# the DTB's __overrides__ block at boot, and pi-zero-w is the one GoSD
# board built from the mainline-style DTS chain, which carries no
# __overrides__ node at all (bean gosd-dkqb). They're kept here anyway, for
# the same reason every other Pi board's config.txt carries them: as a
# statement of intent, and because the firmware only logs and ignores an
# unrecognised dtparam rather than failing the boot. I2C is unaffected -
# bcm2835-rpi.dtsi sets &i2c0/&i2c1 status = "okay" unconditionally, so it
# works regardless of this line. SPI is NOT unaffected: it needs (and, in
# tree, now has) a kernel-build DTS patch instead -
# build/boards/pi-zero-w/kernel/patches/0003-enable-header-spi.patch sets
# &spi status = "okay" directly, since dtparam can't reach this DTB.
dtparam=i2c_arm=on
dtparam=spi=on
{{- if .UsbGadget}}
dtoverlay=dwc2,dr_mode=peripheral
{{- end}}
