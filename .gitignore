# Build outputs that land in the repo root during gate checks
/gosd-init
/gosd
/tio_*

# gosd build-kernel -o out/, when run from the repo root (as its README.md
# examples show) rather than a board's own build/boards/<id>/ directory
/out/

# nix build's output symlink
/result

# Don't track any built images
*.img

# js/ npm workspace
node_modules/
js/**/dist/
js/**/*.tsbuildinfo
js/packages/gosd/integration/fixture/
