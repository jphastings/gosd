# Config fragment for the Pi CM4 trimmed kernel (gosd-1tk8, epic gosd-7676).
#
# Applied on top of `bcm2711_defconfig` — the same single arm64 defconfig
# every currently-maintained rpi-6.x.y branch ships for BCM2710/2711/2712
# boards that pi-zero-2w and pi-3b already build against (see
# build/boards/pi-zero-2w/README.md for the bcmrpi3_defconfig history). The
# CM4's own SoC, BCM2711, is the same silicon pi-3b's defconfig already
# targets — this is a new board in the same kernel family, not a new build
# tier.
#
# Applied via scripts/kconfig/merge_config.sh:
#   merge_config.sh bcm2711_defconfig kernel.fragment
# then `make olddefconfig` to resolve dependent options, producing the full
# kernel.config committed alongside this fragment (by bean gosd-u5yz's real
# build; absent until then).
#
# Everything below asserted =y is required (never =m: CONFIG_MODULES=n,
# nothing loadable). Comments group entries by requirement.
#
# Differences from pi-3b's fragment, deliberate:
# - Native Ethernet, not a USB-attached chip: the CM4's BCM2711 has an
#   onboard Gigabit MAC (GENET) wired directly in the SoC DT, unlike the 3B
#   family's USB-hub-hosted LAN9514/LAN7515. CONFIG_BCMGENET/
#   CONFIG_BROADCOM_PHY/CONFIG_MDIO_BCM_UNIMAC are already =y in the
#   bcm2711_defconfig baseline (confirmed against pi-3b's committed
#   kernel.config, where they appear despite pi-3b's own fragment never
#   mentioning them) — asserted here so a future trim can't cut this
#   board's only network path silently. No CONFIG_USB_DWCOTG/smsc95xx/
#   lan78xx: this board's USB port isn't hard-wired to an Ethernet hub.
# - USB gadget stack IS compiled in (dwc2 dual-role, same block as
#   pi-zero-2w's), unlike pi-3b's outright cut. This is deliberately
#   decoupled from whether gadget mode actually works on this carrier:
#   `internal/boards/picm4`'s UsbGadgetSupport() returns Supported: false
#   because Turing Pi 2's CM4 carrier wiring is uncharacterized, not
#   because the SoC lacks a dwc2 node the way pi-3b's DTB does — so
#   `gosd build --usb-gadget` still refuses today, but characterizing it
#   later (bean gosd-5trv) won't need a kernel rebuild if it turns out to
#   work.
# - SD/eMMC controller: BCM2711 (Pi4-class) uses the newer Broadcom iProc
#   SDHCI block ("emmc2") for its primary SD/eMMC interface, not BCM2835's
#   older proprietary sdhost block pi-3b's CONFIG_MMC_BCM2835 targets.
#   CONFIG_MMC_SDHCI_IPROC asserted below is this board's actual SD-boot
#   storage path — get this wrong and the board doesn't boot at all, not
#   just lose a peripheral. bcm2711_defconfig spans multiple SoC
#   generations in one image, so MMC_BCM2835 may still be =y too; that's
#   harmless dead code on this board, left alone rather than cut.
# - No WiFi/BT block at all: this module is Lite/no-wireless — no
#   BCM43455/cyw43 chip exists to bind brcmfmac to. First Pi board GoSD
#   ships with no wireless firmware or driver surface whatsoever.
# - No ACT-LED DTS patch: pi-zero-2w/pi-zero-w/pi-3b each carry a patch
#   retaining their LED's steady level through shutdown, but whether
#   Turing Pi 2's CM4 carrier wires an LED to the SoC at all is unverified
#   (a compute-module carrier, not a full board with a silkscreened LED) —
#   left for hardware bring-up (bean gosd-5trv) rather than patching a node
#   that may not exist. LEDS_CLASS/LEDS_GPIO/LEDS_TRIGGER_TIMER stay
#   asserted regardless (fleet-wide boot-status feature, and already =y by
#   defconfig default), but not pi-3b's CONFIG_GPIO_BCM_VIRT — that's
#   specific to the 3B family's ACT LED sitting on the firmware's mailbox
#   GPIO, not the real SoC GPIO a CM4-class LED would use.
# - CONFIG_SERIAL_8250_RUNTIME_UARTS=1: same gosd-md4w fix pi-3b/pi-zero-w
#   carry — bcm2711_defconfig ships RUNTIME_UARTS=0 and relies on Pi
#   firmware cmdline injection. Baking =1 in removes that dependency.
#   Both CONFIG_SERIAL_8250 (mini-uart, ttyS0) and CONFIG_SERIAL_AMBA_PL011
#   (ttyAMA0) stay compiled in either way: the Pi firmware's "serial0"
#   alias picks whichever is this board's real console UART (no BT to
#   contest the PL011 on this wireless-less module), and cmdline.txt only
#   ever names "serial0" — never a bare ttyS0/ttyAMA0 — for exactly this
#   reason.

# --- No loadable modules: nothing below may end up "m" ---
# CONFIG_MODULES is not set

# --- Core: devtmpfs, proc, sysfs, initramfs (zstd only), VFAT, tmpfs ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_DEFAULT="cp437"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y

# --- exFAT: the `disk` package mounts an attached drive that arrived
# exFAT-formatted (how most SSDs and USB sticks ship) rather than wiping it,
# and formats one as exFAT when an app needs files above FAT32's 4 GiB
# ceiling. Asserted here rather than inherited, same rationale as every
# other Pi board's fragment. CONFIG_NLS_UTF8 is exFAT's own default
# iocharset. ---
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# --- ext4: `disk`'s default filesystem for attached mass storage (epic
# gosd-lfu0) is ext4; this board has no eMMC/NVMe in scope, so USB drives
# are the affected surface here, same as every other Pi board. ---
CONFIG_EXT4_FS=y

# --- Storage: SD/eMMC via BCM2711's iProc SDHCI block (see header) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y

# --- Net: IPv4 + IPv6, packet sockets, unix sockets ---
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- Wired Ethernet: onboard BCM2711 GENET MAC + Broadcom PHY (see header
# for why these are asserted despite already being defconfig defaults) ---
CONFIG_BCMGENET=y
CONFIG_BROADCOM_PHY=y
CONFIG_MDIO_BCM_UNIMAC=y

# --- USB gadget: DWC2 dual-role, configfs (ACM/ECM/RNDIS) — compiled in
# but NOT claimed supported yet; see header and UsbGadgetSupport(). ---
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Legacy mass-storage gadget: cut for consistency with every other board's
# fragment (bean gosd-z9l4) — a built-in legacy gadget claims the UDC
# before the app's configfs gadget (bean gosd-spjt).
# CONFIG_USB_MASS_STORAGE is not set
# CONFIG_USB_ZERO is not set
# CONFIG_USB_ETH is not set
# CONFIG_USB_GADGETFS is not set
# CONFIG_USB_G_SERIAL is not set
# CONFIG_USB_G_PRINTER is not set
# CONFIG_USB_CDC_COMPOSITE is not set
# CONFIG_USB_G_ACM_MS is not set
# CONFIG_USB_G_MULTI is not set
# CONFIG_USB_G_HID is not set

# --- No WiFi/BT: this module (Lite, no wireless) has no radio at all ---
# CONFIG_BRCMFMAC is not set
# CONFIG_MAC80211_HWSIM is not set
# CONFIG_BT is not set

# --- Peripherals: GPIO cdev (v1 uapi too), I2C, SPI, serial consoles ---
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_SPI=y
CONFIG_SPI_BCM2835=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_BCM2835AUX=y
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- LEDs: the boot-state indicator (gosd-xtcs) drives a GPIO LED through
# the Linux LED class + timer trigger, IF this carrier wires one to the SoC
# at all (unverified — see header). Asserted regardless: fleet-wide
# feature, and already =y by defconfig default. ---
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_TIMER=y

# --- Cut aggressively: no sound, no DRM/video/fb ---
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# No camera/video: disabling the whole media subsystem also removes
# raspberrypi/linux's rp1-cfe and rp1_cfe driver directories, which both
# build and collide at link time (multiple definition of
# dphy_start/dphy_stop/dphy_probe) when CONFIG_MEDIA_SUPPORT is on.
# CONFIG_MEDIA_SUPPORT is not set

# --- Cut aggressively: no filesystems beyond the above (ext4 is enabled
# separately above) ---
# CONFIG_EXT2_FS is not set
# CONFIG_EXT3_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set

# --- Cut aggressively: no crypto beyond what the kernel itself needs ---
# CONFIG_CRYPTO_USER is not set
# CONFIG_CRYPTO_DES is not set
# CONFIG_CRYPTO_TWOFISH is not set
# CONFIG_CRYPTO_CAST5 is not set
# CONFIG_CRYPTO_ADIANTUM is not set
# CONFIG_CRYPTO_CHACHA20POLY1305 is not set

# --- Cut aggressively: optimize for performance, no debug info ---
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_KERNEL is not set
