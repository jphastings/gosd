# Config fragment for the Pi 3B trimmed kernel (gosd-ypg1, epic gosd-xhc3).
#
# Applied on top of `bcm2711_defconfig` — the single arm64 defconfig every
# currently-maintained rpi-6.x.y branch ships for BCM2710/2711/2712 boards
# (see build/boards/pi-zero-2w/README.md for the bcmrpi3_defconfig history).
#
# Applied via scripts/kconfig/merge_config.sh:
#   merge_config.sh bcm2711_defconfig kernel.fragment
# then `make olddefconfig` to resolve dependent options, producing the
# full kernel.config committed alongside this fragment (by bean gosd-0nl7's
# real build; absent until then).
#
# Everything below asserted =y is required (never =m: CONFIG_MODULES=n,
# nothing loadable). Comments group entries by requirement.
#
# Differences from the pi-zero-2w fragment, deliberate:
# - No USB gadget block: the 3B's SoC USB port is hard-wired through the
#   onboard LAN9514 hub, so it can never be a peripheral — no UDC can ever
#   exist on this board. dwc2 and the gadget stack are cut outright.
# - USB HOST + wired Ethernet block: the LAN9514 (USB2 hub + 100Mbit eth) is
#   this board's headline feature. The stock DTB's usb node is
#   compatible "brcm,bcm2708-usb", which binds the rpi tree's dwc_otg driver
#   (CONFIG_USB_DWCOTG) — NOT dwc2, whose of_match table has no bcm2708-usb
#   entry (verified at the pinned commit). All four symbols below are
#   already =y in the bcm2711_defconfig baseline; asserting them here
#   promotes them into kernelspec RequiredY so a future trim can't cut the
#   board's Ethernet silently.
# - CONFIG_SERIAL_8250_RUNTIME_UARTS=1: bcm2711_defconfig ships
#   NR_UARTS=5/RUNTIME_UARTS=0 and relies on the Pi firmware injecting
#   8250.nr_uarts into the cmdline; when that injection doesn't happen the
#   8250 core registers zero ports and the mini-UART console (serial0/ttyS0
#   on this BT-equipped board) never attaches — the exact failure that
#   dead-ended the pi-zero-w bench bring-up (bean gosd-md4w). Baking =1 in
#   removes the firmware dependency. (=1 is not a "=y" line, so it rides the
#   fragment without appearing in RequiredY — that derivation only collects
#   literal =y lines, which is correct.)

# --- No loadable modules: nothing below may end up "m" ---
# CONFIG_MODULES is not set

# --- Core: devtmpfs, proc, sysfs, initramfs (zstd only), VFAT, tmpfs ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_DEFAULT="cp437"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y

# --- Storage: MMC (BCM2835 SDHOST) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y

# --- WiFi: cfg80211, brcmfmac over SDIO, rfkill (BCM43438 = 43430 blobs) ---
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# CONFIG_BRCMFMAC_USB is not set
CONFIG_RFKILL=y
# bcm2711_defconfig ships mac80211_hwsim as =m and the ModulesDisabled
# build would promote it to =y, creating simulated radios (with no
# firmware 4-way-handshake offload) that wifiup can pick over the real
# one — the trap that bit pi-zero-w and pi-zero-2w (bean gosd-6nl2).
# Disabled from birth; this board's kernel has never been built.
# CONFIG_MAC80211_HWSIM is not set

# --- Net: IPv4 + IPv6, packet sockets, unix sockets ---
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- USB HOST + wired Ethernet: dwc_otg host controller, LAN9514 (smsc95xx) ---
# See the header comment: the LAN9514 hub+eth hangs off the SoC's only USB
# port, routed by the stock DTB to the bcm2708-usb node -> dwc_otg driver.
CONFIG_USB=y
CONFIG_USB_DWCOTG=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y

# --- No USB gadget: hub-wired port can never be a peripheral (see header) ---
# CONFIG_USB_DWC2 is not set
# CONFIG_USB_GADGET is not set
# Legacy mass-storage gadget: kept cut for consistency with every other
# board's fragment (bean gosd-z9l4), and doubly dead here with no UDC.
# CONFIG_USB_MASS_STORAGE is not set

# --- Peripherals: GPIO cdev (v1 uapi too), I2C, SPI, serial consoles ---
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_SPI=y
CONFIG_SPI_BCM2835=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_BCM2835AUX=y
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- Cut aggressively: no sound, no DRM/video/fb, no bluetooth ---
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BT is not set
# No camera/video: disabling the whole media subsystem also removes
# raspberrypi/linux's rp1-cfe and rp1_cfe driver directories, which
# both build and collide at link time (multiple definition of
# dphy_start/dphy_stop/dphy_probe) when CONFIG_MEDIA_SUPPORT is on.
# CONFIG_MEDIA_SUPPORT is not set

# --- Cut aggressively: no filesystems beyond the above ---
# CONFIG_EXT4_FS is not set
# CONFIG_EXT2_FS is not set
# CONFIG_EXT3_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set

# --- Cut aggressively: no crypto beyond what the kernel itself needs ---
# CONFIG_CRYPTO_USER is not set
# CONFIG_CRYPTO_DES is not set
# CONFIG_CRYPTO_TWOFISH is not set
# CONFIG_CRYPTO_CAST5 is not set
# CONFIG_CRYPTO_ADIANTUM is not set
# CONFIG_CRYPTO_CHACHA20POLY1305 is not set

# --- Cut aggressively: optimize for performance, no debug info ---
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_KERNEL is not set
