# Config fragment for the Pi Zero W trimmed kernel (gosd-s7fk, epic
# gosd-ajpz). Mirrors build/boards/pi-zero-2w/kernel.fragment's trim
# one-for-one (same requirement list from the bean), applied on top of
# `bcmrpi_defconfig` — the armv6 defconfig covering the original BCM2835
# family (Pi 1, Pi Zero, Pi Zero W) — instead of pi-zero-2w's arm64
# `bcm2711_defconfig`. See build.sh and README.md for why bcmrpi_defconfig is
# the right base for this board.
#
# Applied via scripts/kconfig/merge_config.sh:
#   merge_config.sh bcmrpi_defconfig kernel.fragment
# then `make olddefconfig` to resolve dependent options, producing the full
# kernel.config committed alongside this fragment.
#
# Everything below is required =y (never =m: CONFIG_MODULES=n, nothing
# loadable). Comments group entries by the bean's requirement list.

# --- No loadable modules: nothing below may end up "m" ---
# CONFIG_MODULES is not set

# --- Core: devtmpfs, proc, sysfs, initramfs (zstd only), VFAT, tmpfs ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_DEFAULT="cp437"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y

# --- exFAT: the `disk` package mounts an attached drive that arrived
# exFAT-formatted (how most SSDs and USB sticks ship) rather than wiping it,
# and formats one as exFAT when an app needs files above FAT32's 4 GiB
# ceiling. Asserted here rather than inherited: the Pi defconfig happens to
# set CONFIG_EXFAT_FS=y today, which is luck, not a promise. CONFIG_NLS_UTF8
# is exFAT's own default iocharset (fs/exfat/Kconfig's
# EXFAT_DEFAULT_IOCHARSET); the codepage/iso8859 NLS options above stay for
# vfat. ---
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# --- ext4: `disk`'s default filesystem for attached mass storage (epic
# gosd-lfu0) is ext4; the Pi boards have no eMMC/NVMe, so USB drives are
# the affected surface here (decision JP 2026-08-07, bean gosd-19kw).
# fs/ext4/Kconfig's EXT4_FS selects BUFFER_HEAD, JBD2, CRC16, CRC32 and
# FS_IOMAP at the pinned commit — verified these chain automatically
# under merge_config.sh + olddefconfig with no companion fragment lines. ---
CONFIG_EXT4_FS=y

# --- Storage: MMC (BCM2835 SDHOST) ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835=y

# --- WiFi: cfg80211, brcmfmac over SDIO, rfkill ---
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# CONFIG_BRCMFMAC_USB is not set
CONFIG_RFKILL=y
# The BCM43430's SDIO bus needs its own controller driver: this board
# boots the mainline-style DT (bcm2835-rpi-zero-w.dtb), whose WiFi node
# sits on the `brcm,bcm2835-sdhci` controller that only sdhci-iproc
# binds. bcmrpi_defconfig instead covers WiFi SDIO with the downstream
# bcm2835-mmc driver, which matches downstream-only DT compatibles — so
# without this the radio never enumerates at all (bean gosd-6nl2).
CONFIG_MMC_SDHCI_IPROC=y
# bcmrpi_defconfig ships mac80211_hwsim as =m and the ModulesDisabled
# build promotes it to =y, creating two simulated radios (wlan0/wlan1)
# with no firmware 4-way-handshake offload; wifiup picked a phantom and
# every WPA2 CONNECT was EINVAL'd (bean gosd-6nl2).
# CONFIG_MAC80211_HWSIM is not set

# --- Net: IPv4 + IPv6, packet sockets, unix sockets ---
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- USB gadget: DWC2 dual-role, configfs (ACM/ECM/RNDIS) ---
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Legacy mass-storage gadget (drivers/usb/gadget/legacy/) leaks in as =y
# from the bcmrpi_defconfig baseline. It auto-binds the UDC at boot with
# no backing file ("no file given for LUN0", probe fails -22) and can
# contend with the configfs gadget stack above, which is what GoSD
# actually uses. Found during rock-4se real-hardware bring-up (bean
# gosd-sz6p); this board leaks the same symbol from its own defconfig.
# CONFIG_USB_MASS_STORAGE is not set
# The REST of the legacy gadget zoo leaks in the same way: bcmrpi_defconfig
# ships these =m and the ModulesDisabled build promotes them to =y (the
# same trap as mac80211_hwsim above). Built-in, whichever initializes first
# claims the board's only UDC before the app can apply its configfs gadget —
# the 2026-07-26 Zero W bench test enumerated as the kernel's own "Gadget
# Zero" test device (0x0525/0xa4a0) instead of the app's mass-storage
# gadget (bean gosd-spjt). The configfs function drivers above stay in.
# CONFIG_USB_ZERO is not set
# CONFIG_USB_ETH is not set
# CONFIG_USB_GADGETFS is not set
# CONFIG_USB_G_SERIAL is not set
# CONFIG_USB_G_PRINTER is not set
# CONFIG_USB_CDC_COMPOSITE is not set
# CONFIG_USB_G_ACM_MS is not set
# CONFIG_USB_G_MULTI is not set
# CONFIG_USB_G_HID is not set

# --- Peripherals: GPIO cdev (v1 uapi too), I2C, SPI, serial consoles ---
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_SPI=y
CONFIG_SPI_BCM2835=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# bcmrpi_defconfig ships CONFIG_SERIAL_8250_RUNTIME_UARTS=0 and relies on the
# Pi firmware injecting `8250.nr_uarts=1` into the kernel cmdline. Our zero-w
# bench boot got no such injection, so the 8250 core aborted init (nr_uarts=0),
# the mini-UART console probe failed -EINVAL, and its error path clock-gated
# the AUX block — killing earlycon on the same peripheral too. Register the
# one port at boot unconditionally instead (gosd-md4w).
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_8250_BCM2835AUX=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- Cut aggressively: no sound, no DRM/video/fb, no bluetooth ---
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BT is not set
# No camera/video: disabling the whole media subsystem also removes
# raspberrypi/linux's rp1-cfe and rp1_cfe driver directories, which both
# build and collide at link time (multiple definition of
# dphy_start/dphy_stop/dphy_probe) when CONFIG_MEDIA_SUPPORT is on — same
# issue as pi-zero-2w, kept for consistency even though this armv6 board
# never has an RP1.
# CONFIG_MEDIA_SUPPORT is not set

# --- Cut aggressively: no filesystems beyond the above (ext4 is enabled
# separately above) ---
# CONFIG_EXT2_FS is not set
# CONFIG_EXT3_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set

# --- Cut aggressively: no crypto beyond what the kernel itself needs ---
# CONFIG_CRYPTO_USER is not set
# CONFIG_CRYPTO_DES is not set
# CONFIG_CRYPTO_TWOFISH is not set
# CONFIG_CRYPTO_CAST5 is not set
# CONFIG_CRYPTO_ADIANTUM is not set
# CONFIG_CRYPTO_CHACHA20POLY1305 is not set

# --- Cut aggressively: optimize for performance, no debug info ---
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_KERNEL is not set
