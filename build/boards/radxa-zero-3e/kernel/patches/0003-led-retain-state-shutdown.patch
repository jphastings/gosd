--- a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi
@@ -28,7 +28,22 @@
 
 		led-green {
 			color = <LED_COLOR_ID_GREEN>;
-			default-state = "on";
+			/*
+			 * GoSD (github.com/jphastings/gosd): this LED is GoSD's
+			 * status LED (bean gosd-n82u) - solid on means a fatal
+			 * error was reported (fault.Fatal, see
+			 * docs/status-led.md). default-state = "off" (was "on")
+			 * means solid-on can only be gosd-init's fault report,
+			 * never whatever level the GPIO comes up in before
+			 * gosd-init claims the LED. retain-state-shutdown stops
+			 * gpio_led_shutdown() clearing that report during
+			 * device_shutdown(), so a fatal error's steady level
+			 * survives the halt. This dtsi is shared with sibling
+			 * Radxa Zero 3 boards - harmless, since GoSD only ships
+			 * its own rk3566-radxa-zero-3e.dtb. See bean gosd-54j8.
+			 */
+			default-state = "off";
+			retain-state-shutdown;
 			function = LED_FUNCTION_HEARTBEAT;
 			gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
 			linux,default-trigger = "heartbeat";
