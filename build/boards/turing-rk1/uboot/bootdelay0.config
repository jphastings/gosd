# Config fragment merged onto turing-rk1-rk3588_defconfig.
#
# Setting the boot delay to zero removes the countdown so distro-boot
# proceeds straight to extlinux.conf. Holding a key during boot still drops
# to the U-Boot prompt (abort-with-keypress), so this does not remove the
# dev escape hatch -- it just removes the wait when nobody's pressing
# anything.
#
# Do NOT add CONFIG_BOOTSTD_FULL=n or similar here: distro-boot/bootstd must
# stay enabled, since that's what finds extlinux/extlinux.conf on the first
# FAT partition of the SD card.
CONFIG_BOOTDELAY=0

# Real hardware bring-up on rock-4se (bean gosd-sz6p, 2026-07-23) found
# U-Boot scanning the global 'efi_mgr' bootmeth before extlinux on every
# boot: it probes for a Boot0000 EFI entry, fails, and prints ~6 lines of
# "Boot failed"-shaped noise before falling through to the extlinux bootmeth
# that actually works. This board hasn't had its own hardware bring-up yet
# (bean gosd-hycf), but turing-rk1-rk3588_defconfig (checked at the pinned
# UBOOT_TAG) doesn't set CONFIG_BOOTMETH_EFI_BOOTMGR itself either, so the
# same boot/Kconfig default (`default y`, depends on EFI_BOOTMGR, which
# defaults y for arm64) applies here -- verified against u-boot v2026.04's
# boot/Kconfig and lib/efi_loader/Kconfig, same as rock-4se's and
# radxa-zero-3e's fragments reasoned. Turning it off only drops the global
# efi_mgr scan; BOOTMETH_EXTLINUX (boot/Kconfig, `default y`, unconditional)
# is untouched, so extlinux discovery is unaffected.
# CONFIG_BOOTMETH_EFI_BOOTMGR is not set

# turing-rk1-rk3588_defconfig never sets CONFIG_ENV_IS_IN_MMC (unlike
# rock-4se's rk3399 defconfig), so env/Kconfig's ENV_IS_DEFAULT already
# resolves to ENV_IS_NOWHERE here by Kconfig default -- no
# environment-related fragment change needed, same as radxa-zero-3e's and
# nanopi-zero2's defconfigs.
