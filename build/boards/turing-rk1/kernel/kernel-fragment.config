# Turing RK1 (RK3588) trimmed mainline kernel — config fragment.
#
# Merged onto `make ARCH=arm64 defconfig` via scripts/kconfig/merge_config.sh,
# then finalized with `make olddefconfig` (see internal/kernelspec.go's
# fleetKernelTag for the pinned source tag this was verified against). The
# resulting full config is committed as kernel.config once a real
# `gosd build-kernel` run has produced one (bean gosd-phjh).
#
# Everything below is a hard requirement (all =y, CONFIG_MODULES=n — no
# loadable modules at all). Symbol names were verified against the pinned
# kernel source tree (drivers/phy/rockchip/Kconfig,
# drivers/pci/controller/dwc/Kconfig at v6.18), not assumed from RK3399/RK3566
# precedent — RK3588 uses different PHY/PCIe IP than the rest of this fleet's
# Rockchip boards (see bean gosd-k4w2's research).
#
# GPIO/I2C/SPI header peripherals are deliberately NOT asserted here: this
# board's epic (gosd-bntd) scopes the header out entirely (only the Turing
# Pi 2 baseboard's Node-1 slot exposes one at all, and that's a baseboard
# property, not this module's).

# --- No loadable modules ---
# CONFIG_MODULES is not set

# --- Core / initramfs / vfat / net baseline (same as the rest of the fleet) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- exFAT: the `disk` package mounts an attached drive that arrived
# exFAT-formatted rather than wiping it, and formats one as exFAT when an
# app needs files above FAT32's 4 GiB ceiling. Enabled fleet-wide so what
# `disk` can do doesn't depend on which board an app was built for. ---
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# --- SoC ---
CONFIG_ARCH_ROCKCHIP=y

# --- Storage: onboard eMMC only — this module has no SD slot at all (the
# epic's central finding), so no dw_mmc/SD controller is enabled, only the
# DesignWare-derived SDHCI eMMC controller shared with radxa-zero-3e. ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# --- Ethernet: rk3588-turing-rk1.dtsi gmac1 -> RTL8211F (RGMII) PHY,
# same STMMAC/dwmac-rk driver family the rest of the Rockchip fleet uses. ---
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_REALTEK_PHY=y

# --- USB gadget: rk3588-turing-rk1.dtsi's u2phy0_otg (USB2 PHY, status
# okay) is the gadget-mode candidate; the board's other USB port
# (usb_host1_xhci) is fixed dr_mode="host" and out of scope here. RK3588
# uses different PHY IP than RK3399/RK3566 for its combo USB3/DP port
# (PHY_ROCKCHIP_USBDP), but the plain USB2 OTG PHY is the same Innosilicon
# IP (PHY_ROCKCHIP_INNO_USB2) shared across the whole Rockchip family —
# confirmed against drivers/phy/rockchip/Kconfig at the pinned tag. ---
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Legacy mass-storage gadget (drivers/usb/gadget/legacy/) leaks in as =y from
# the arm64 defconfig baseline fleet-wide (see radxa-zero-3e's and
# rock-4se's fragments — the same defconfig-promotion trap, not verified
# again per-board since it's a defconfig-level default, not an SoC one).
# CONFIG_USB_MASS_STORAGE is not set

# --- PCIe/NVMe: the per-node M.2 slot on the Turing Pi 2 baseboard, in
# scope as ADDITIONAL storage via the `disk` package only — NOT a boot
# medium (this board boots from eMMC only; see the epic's locked
# decisions). RK3588 uses the newer DesignWare-based Rockchip PCIe
# controller, NOT rock-4se's RK3399-only CONFIG_PCIE_ROCKCHIP_HOST —
# confirmed against drivers/pci/controller/dwc/Kconfig at the pinned tag
# ("except RK3399" is explicit in that Kconfig's help text). ---
CONFIG_PCI=y
CONFIG_PCIE_ROCKCHIP_DW_HOST=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_BLK_DEV_NVME=y

# --- Serial: same 8250-derived UART IP the rest of the Rockchip fleet uses. ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# --- Filesystems: btrfs leaks in as CONFIG_BTRFS_FS=y from the arm64
# defconfig baseline (=m promoted to =y by the no-modules build) — nothing
# in gosd formats or mounts btrfs, same cut as the rest of the fleet. ---
# CONFIG_BTRFS_FS is not set

# --- Cut: no display/audio/BT in scope for this bring-up, no debug info ---
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_BT is not set
CONFIG_DEBUG_INFO_NONE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
