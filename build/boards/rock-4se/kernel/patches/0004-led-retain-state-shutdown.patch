--- a/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3399-rock-pi-4.dtsi
@@ -35,6 +35,22 @@
 		led-0 {
 			function = LED_FUNCTION_STATUS;
 			color = <LED_COLOR_ID_BLUE>;
+			/*
+			 * GoSD (github.com/jphastings/gosd): this LED is GoSD's
+			 * status LED (bean gosd-n82u) - solid on means a fatal
+			 * error was reported (fault.Fatal, see
+			 * docs/status-led.md). This node had no default-state -
+			 * "off" means solid-on can only be gosd-init's fault
+			 * report, never whatever level the GPIO comes up in
+			 * before gosd-init claims the LED. retain-state-shutdown
+			 * stops gpio_led_shutdown() clearing that report during
+			 * device_shutdown(), so a fatal error's steady level
+			 * survives the halt. This dtsi is shared with sibling
+			 * ROCK Pi 4 boards - harmless, since GoSD only ships its
+			 * own rk3399-rock-4se.dtb. See bean gosd-54j8.
+			 */
+			default-state = "off";
+			retain-state-shutdown;
 			gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
 			linux,default-trigger = "heartbeat";
 		};
