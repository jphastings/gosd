# Config fragment merged onto radxa-cubie-a5e_defconfig.
#
# Setting the boot delay to zero removes the countdown so distro-boot
# proceeds straight to extlinux.conf. Holding a key during boot still drops
# to the U-Boot prompt (abort-with-keypress), so this does not remove the
# dev escape hatch -- it just removes the wait when nobody's pressing
# anything.
#
# Do NOT add CONFIG_BOOTSTD_FULL=n or similar here: distro-boot/bootstd must
# stay enabled, since that's what finds extlinux/extlinux.conf on the first
# FAT partition of the SD card.
CONFIG_BOOTDELAY=0

# Unlike rock-4se-rk3399_defconfig, radxa-cubie-a5e_defconfig (checked at
# U-Boot v2026.04, the tag this board is pinned to) sets no CONFIG_ENV_IS_IN_*
# option, so env/Kconfig's `ENV_IS_DEFAULT` (def_bool y when no ENV_IS_IN_* is
# set) already selects ENV_IS_NOWHERE by Kconfig default -- the same situation
# as radxa-zero-3e/nanopi-zero2's defconfigs. No environment-source fragment
# needed here.
