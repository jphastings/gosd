# Radxa Cubie A5E (Allwinner A527, sun55iw3) trimmed mainline kernel — config
# fragment.
#
# Merged onto `make ARCH=arm64 defconfig` via scripts/kconfig/merge_config.sh,
# then finalized with `make olddefconfig` (see build/boards/nanopi-zero2's
# fragment for the general shape this one follows). The resulting full config
# is committed as kernel.config once a real `gosd build-kernel` run produces
# one (bean gosd-axtv; not yet done as of this fragment's authoring — see
# this board's README.md).
#
# Everything below is a hard requirement (all =y, CONFIG_MODULES=n — no
# loadable modules at all). Symbol names were verified against the pinned
# kernel source tree (v6.18.37 — sun55i-a523.dtsi, sun55i-a527-cubie-a5e.dts,
# and the matching driver of_device_id/Kconfig tables), not assumed from
# documentation. Built by starting from
# build/boards/nanopi-zero2/kernel/kernel-fragment.config (closest fleet
# template: same mainline arm64 defconfig base and trim policy) and
# re-deriving every SoC-specific line for the A527 — every Rockchip-specific
# option (CONFIG_ARCH_ROCKCHIP, the dw_mmc/dwcmshc storage pair,
# CONFIG_GPIO_ROCKCHIP, CONFIG_I2C_RK3X, CONFIG_SPI_ROCKCHIP, CONFIG_DWMAC_
# ROCKCHIP, CONFIG_PHY_ROCKCHIP_*) is dropped rather than carried over. See
# bean gosd-jpc8 for the verified compatible→driver map this was built from.

# --- No loadable modules ---
# CONFIG_MODULES is not set

# --- Core / initramfs / vfat / net baseline (same as every other board) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- exFAT: the `disk` package mounts an attached drive that arrived
# exFAT-formatted (how most SSDs and USB sticks ship) rather than wiping it,
# and formats one as exFAT when an app needs files above FAT32's 4 GiB
# ceiling. arm64 defconfig leaves this off; it is enabled so that what the
# `disk` package can do does not depend on which board an app was built for.
# CONFIG_NLS_UTF8 is exFAT's own default iocharset (fs/exfat/Kconfig's
# EXFAT_DEFAULT_IOCHARSET); the codepage/iso8859 NLS options above stay for
# vfat. ---
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# --- SoC ---
CONFIG_ARCH_SUNXI=y

# --- Pinctrl/GPIO: sun55i-a527-cubie-a5e.dts's PIO nodes use
# "allwinner,sun55i-a523-pinctrl" (main PIO bank) and the r_pio node uses
# "...-r-pinctrl" (RTC-domain PIO, feeding the PMIC's r_i2c0 pins below).
# Unlike Rockchip, sunxi has no separate GPIO_* driver — pinctrl-sunxi
# registers the gpiochip itself, so these two symbols are both the pinctrl
# AND the GPIO driver for this SoC. ---
CONFIG_PINCTRL_SUN55I_A523=y
CONFIG_PINCTRL_SUN55I_A523_R=y

# --- Storage: microSD only (mmc0, "allwinner,sun20i-d1-mmc" fallback
# compatible → CONFIG_MMC_SUNXI). No eMMC node is enabled in the board DT at
# this tag (bean gosd-jpc8), so eMMC is out of scope — matches the epic's
# SD-boot-only decision. mmc0's vmmc-supply is the AXP717 PMIC's cldo3 rail
# (see the PMIC entry below): without CONFIG_MFD_AXP20X_I2C +
# CONFIG_REGULATOR_AXP20X the card has no power and vanishes mid-boot. ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y

# --- Ethernet: sun55i-a527-cubie-a5e.dts gmac0 -> RGMII -> RTL8211F PHY
# (allwinner,sun50i-a64-emac fallback compatible → the sunxi glue driver;
# Radxa's spec sheet names the fitted chip, the DT's MDIO child uses the
# generic "ethernet-phy-ieee802.3-c22" compatible so the driver binds by
# probed chip ID, same shape as every Rockchip board in this fleet). Second
# GbE (GMAC200) and onboard WiFi/BT are both out of scope at this kernel tag
# (bean gosd-jpc8) — no driver/DT node for either. ---
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_REALTEK_PHY=y

# --- USB gadget: usb_otg is already pinned dr_mode="peripheral" in the board
# DT (allwinner,sun8i-a33-musb fallback compatible → CONFIG_USB_MUSB_SUNXI) —
# no DTS patch needed, unlike rock-4se's dwc3 port which had to be flipped
# from its DT default of "host". CONFIG_USB_MUSB_SUNXI depends on
# CONFIG_NOP_USB_XCEIV + CONFIG_PHY_SUN4I_USB (the transceiver/PHY backing
# usbphy's port 0 — verified in drivers/usb/musb/Kconfig at the pinned tag);
# CONFIG_USB_MUSB_DUAL_ROLE mirrors the other boards' *_DUAL_ROLE choice
# (the DT's static dr_mode, not this Kconfig choice, is what actually pins
# this port to peripheral-only at runtime). The gadget/configfs function set
# below is the same one every gadget-capable board in this fleet carries
# (radxa-zero-3e's fragment) — no board-specific function (e.g. mass
# storage) is needed here yet. ---
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Legacy mass-storage gadget (drivers/usb/gadget/legacy/) leaks in as =y
# from the arm64 defconfig baseline. It auto-binds the UDC at boot with no
# backing file and contends with the configfs gadget stack GoSD actually
# uses — the same real-hardware failure hit on rock-4se during bring-up
# (bean gosd-sz6p). Cut here pre-emptively.
# CONFIG_USB_MASS_STORAGE is not set

# --- USB host: ehci0/ohci0 (usbphy port 0, shared with usb_otg's PHY) and
# ehci1/ohci1 (usbphy port 1, the USB-A host port) are all status="okay" in
# the board DT, using the "generic-ehci"/"generic-ohci" fallback compatibles
# — the platform-bus glue drivers, not the PCI ones. A523 has no xHCI/USB3
# host controller node at this kernel tag, so no CONFIG_USB_XHCI_* entry is
# needed here. ---
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# --- Peripherals: I2C + PMIC. r_i2c0 (allwinner,sun6i-a31-i2c fallback
# compatible, same driver every I2C bus on this SoC uses) carries the two
# PMICs the board DT enables: AXP717 at 0x34 (main rails, including mmc0's
# vmmc) and AXP323 at 0x36 (secondary rails). Both bind via
# CONFIG_MFD_AXP20X_I2C's of_device_id table (x-powers,axp717 /
# x-powers,axp323); CONFIG_REGULATOR_AXP20X supplies the regulator framework
# glue both PMICs need to actually switch their rails on. These are a hard
# boot dependency, not an optional peripheral — see the Storage entry above.
# ---
CONFIG_I2C=y
CONFIG_I2C_MV64XXX=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y

# --- RTC: rtc node uses the allwinner,sun50i-r329-rtc fallback compatible. --
CONFIG_RTC_DRV_SUN6I=y

# --- UART: uart0 (stdout-path = "serial0:115200n8") uses the same
# snps,dw-apb-uart compatible as every other board in this fleet — same
# driver, different default baud (115200, not the Rockchip boards' 1500000;
# see internal/boards/cubiea5e's defaultConsoleBaud). ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# --- GPIO character devices (gpiod tooling) ---
CONFIG_GPIO_CDEV=y

# --- Header SPI: DELIBERATELY NOT A REQUIREMENT (no entries here). Unlike
# the Rockchip boards, sun55i-a523.dtsi has NO spi node at all at this
# kernel tag — there is nothing for a peripheral-enablement DTS patch to
# flip to "okay" (bean gosd-jpc8). Revisit when the fleet kernel tag bumps
# to a version with SPI support for this SoC.

# --- Cut: no WiFi in-tree (the onboard module's driver isn't mainline; see
# bean gosd-jpc8), no sound/DRM/BT/media/GPU, no debug info ---
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_BT is not set
CONFIG_DEBUG_INFO_NONE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
