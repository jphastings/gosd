# NVIDIA Jetson Nano 16GB eMMC module (Tegra210, P3448-0002)
# trimmed mainline kernel — config fragment.
#
# Merged onto `make ARCH=arm64 defconfig` via scripts/kconfig/merge_config.sh,
# then finalized with `make olddefconfig` (see internal/kernelspec.go's
# fleetKernelTag for the pinned source tag this was verified against). The
# resulting full config is committed as kernel.config once a real
# `gosd build-kernel` run has produced one (bean gosd-cxio).
#
# Everything below is a hard requirement (all =y, CONFIG_MODULES=n — no
# loadable modules at all). Symbol names were verified against the pinned
# kernel source tree (v6.18.37), and the driver set follows what
# tegra210-p3450-0000.dts enables, not L4T precedent. The arm64 defconfig
# already builds every Tegra210 driver below in (the released rock-4se
# kernel.config, same defconfig and tag, shows each one =y); they are listed
# so a kernel bump that drops one fails the build instead of the bench.

# --- No loadable modules ---
# CONFIG_MODULES is not set

# --- Core / initramfs / vfat / net baseline (same as the rest of the fleet) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- exFAT: the `disk` package mounts an attached drive that arrived
# exFAT-formatted rather than wiping it, and formats one as exFAT when an
# app needs files above FAT32's 4 GiB ceiling. Enabled fleet-wide so what
# `disk` can do doesn't depend on which board an app was built for. ---
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# --- SoC: TEGRA_MC is load-bearing — without the memory controller the PMC
# probe defers forever (Armbian found this, armbian/build#11034). ---
CONFIG_ARCH_TEGRA=y
CONFIG_ARCH_TEGRA_210_SOC=y
CONFIG_TEGRA_MC=y

# --- PMIC: the MAX77620 on i2c@7000d000 is a boot dependency, not a
# peripheral. The eMMC's vqmmc (VDD_1V8, sd3), PCIe's vdd_pex_1v05 (ldo1)
# and VDD_3V3_SYS (enabled by PMIC GPIO 3, the eMMC's vmmc) all come from
# it, so without the I2C, MFD, regulator, GPIO and pinctrl drivers the eMMC,
# Ethernet and NVMe never probe. ---
CONFIG_I2C=y
CONFIG_I2C_TEGRA=y
CONFIG_MFD_MAX77620=y
CONFIG_REGULATOR_MAX77620=y
CONFIG_GPIO_MAX77620=y
CONFIG_PINCTRL_MAX77620=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# --- Storage: the eMMC on SDMMC4 (mmc@700b0600, enabled by
# patches/0001-enable-emmc.patch). Its user area carries NVIDIA's GPT, and
# GoSD's boot partition is the APP partition in it, so the kernel must parse
# GPT. /data lives on the NVMe drive behind PCIe (bean gosd-j18s). ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_TEGRA=y
CONFIG_EFI_PARTITION=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# --- Ethernet: an RTL8111 behind PCIe root port pci@2,0. ---
CONFIG_PCI=y
CONFIG_PCI_TEGRA=y
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y

# --- USB: every port sits behind XUSB — the pad controller plus the xHCI
# host, which needs nvidia/tegra210/xusb.bin at probe (shipped in the
# initramfs from linux-firmware, see ../manifest.json). ---
CONFIG_USB=y
CONFIG_PHY_TEGRA_XUSB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_TEGRA=y
# Legacy mass-storage gadget (drivers/usb/gadget/legacy/) leaks in as =y from
# the arm64 defconfig baseline and auto-binds the UDC at boot, contending
# with the configfs gadget GoSD uses — the same cut as the rest of the fleet.
# CONFIG_USB_MASS_STORAGE is not set

# --- Header GPIO (the J41 header's I2C and SPI buses are disabled in the
# pinned DTS — see docs/development/jetson-nano.md). ---
CONFIG_GPIO_TEGRA=y
CONFIG_GPIO_CDEV=y

# --- QSPI: spi@70410000 is enabled in the DTS with the NOR flash that holds
# NVIDIA's whole boot chain. Nothing in GoSD reads it, and the defconfig's
# =m driver (promoted to =y) would hand app code a writable /dev/mtd0 over
# the bootloader. ---
# CONFIG_SPI_TEGRA210_QUAD is not set

# --- vsock (host side): VMs this board runs under QEMU/KVM get a vsock
# channel through /dev/vhost-vsock; Tangled Spindle's microVM engine is the
# first consumer. VSOCKETS + VHOST_VSOCK are the hard requirements; DIAG
# (`ss`), LOOPBACK and VSOCKMON (packet capture, needs VHOST_VSOCK) match
# the Pi CM4's kernel. ---
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=y
CONFIG_VSOCKETS_LOOPBACK=y
CONFIG_VHOST_VSOCK=y
CONFIG_VSOCKMON=y

# --- Serial: UART-A (the debug port, serial0 alias -> ttyS0). The Tegra
# UART binds "nvidia,tegra20-uart" through 8250_tegra, not the generic
# SERIAL_OF_PLATFORM driver. ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_TEGRA=y

# --- Filesystems: btrfs leaks in as CONFIG_BTRFS_FS=y from the arm64
# defconfig baseline (=m promoted to =y by the no-modules build) — nothing
# in gosd formats or mounts btrfs, same cut as the rest of the fleet. ---
# CONFIG_BTRFS_FS is not set

# --- Cut: no onboard WiFi, no display/audio/BT in scope, no debug info ---
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_BT is not set
CONFIG_DEBUG_INFO_NONE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
